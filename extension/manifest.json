{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "Echo360 Track Downloader",
  "version": "0.3.0",
  "description": "Detects Echo360 lecture media and downloads the authorized video and audio tracks.",
  "permissions": ["alarms", "downloads", "scripting", "storage", "webRequest"],
  "host_permissions": [
    "https://echo360.net.au/*",
    "https://content.echo360.net.au/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Echo360 Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://echo360.net.au/lesson/*",
        "https://echo360.net.au/section/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
